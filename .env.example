# ===================================================================
# BitePulse - Environment Variables Template
# Copy this file to .env and fill in your actual environment secrets.
# NEVER commit the .env file to version control.
# ===================================================================

# -----------------
# Backend Security (Spring Boot)
# -----------------
# 256-bit cryptographic secret for signing stateless JWT tokens
JWT_SECRET=your-secure-production-cryptographic-jwt-token-signing-key-minimum-32-chars

# Token expiration time in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# Backend Server Port
SERVER_PORT=8080

# Active Spring Profile (local for H2 in-memory, mysql for production MySQL)
SPRING_PROFILES_ACTIVE=local

# -----------------
# Database Configuration (MySQL - Optional for production)
# -----------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bitepulse_db
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_database_password_here

# -----------------
# Frontend Configuration (Vite + React)
# -----------------
# Base URL pointing to the Spring Boot REST API
VITE_API_URL=http://localhost:8080/api
VITE_APP_NAME=BitePulse
VITE_APP_ENV=development
